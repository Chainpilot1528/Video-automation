      "leading_silence_seconds": 0.0,
      "trailing_silence_seconds": 0.0,
      "sentences": [
        {
          "text": "Five steps down, the answers have turned upside down.",
          "start": 0.0,
          "end": 2.99
        },
        {
          "text": "Pleasure, then purpose, then control, then doubt.",
          "start": 3.41,
          "end": 6.045
        },
        {
          "text": "And finally: stop looking straight at it.",
          "start": 6.595,
          "end": 8.844
        },
        {
          "text": "Maybe happiness isn't something you hold.",
          "start": 9.174,
          "end": 11.536
        },
        {
          "text": "Maybe it's what happens while you're holding something else.",
          "start": 12.156,
          "end": 15.048
        }
      ],
      "warnings": []
    }
