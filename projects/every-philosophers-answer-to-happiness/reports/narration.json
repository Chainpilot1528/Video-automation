      "leading_silence_seconds": 0.0,
      "trailing_silence_seconds": 0.0,
      "sentences": [
        {
          "text": "Deeper still are the Stoics.",
          "start": 0.0,
          "end": 1.828
        },
        {
          "text": "Epictetus was born a slave, so he knew how little of life we control.",
          "start": 2.248,
          "end": 6.391
        },
        {
          "text": "He moved happiness to the one place no one else can reach: our own judgements.",
          "start": 6.941,
          "end": 11.442
        },
        {
          "text": "Men are disturbed not by things, but by the views which they take of things.",
          "start": 11.772,
          "end": 15.945
        },
        {
          "text": "Change the view, and the storm loses its grip.",
          "start": 16.565,
          "end": 19.347
        }
      ],
      "warnings": []
    },
    {
      "scene_id": "s05-schopenhauer",
      "asset_id": "narr-s05-schopenhauer",
      "route": "tts",
      "path": "narration/s05-schopenhauer/8612bc388ad9c303.wav",
      "sha256": "6adca9ab455319d899de504dac39ab1c36c5a3a2d329dced62cb7507ce78feb2",
      "fingerprint": "8612bc388ad9c303c38094003309917f2196cf3b6513e5ffca4ecaea556319a3",
      "cached": false,
      "duration_seconds": 20.525,
      "sample_rate": 48000,
