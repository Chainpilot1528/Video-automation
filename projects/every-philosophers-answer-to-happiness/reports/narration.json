      "true_peak_dbtp": -1.8,
      "leading_silence_seconds": 0.0,
      "trailing_silence_seconds": 0.0,
      "sentences": [
        {
          "text": "At the bottom is a surprise.",
          "start": 0.0,
          "end": 1.932
        },
        {
          "text": "In the autumn of 1826, a young John Stuart Mill fell into a crisis he could not shake.",
          "start": 2.352,
          "end": 8.2
        },
        {
          "text": "What he took from it is the strangest advice on this list.",
          "start": 8.75,
          "end": 12.244
        },
        {
          "text": "Ask yourself whether you are happy, and you cease to be so.",
          "start": 12.574,
          "end": 15.797
        },
        {
          "text": "Happiness, he decided, comes by the way, while you are aiming at something else.",
          "start": 16.417,
          "end": 20.556
        }
      ],
      "warnings": []
    },
    {
      "scene_id": "s07-close",
      "asset_id": "narr-s07-close",
