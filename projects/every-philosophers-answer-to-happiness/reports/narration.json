      "integrated_lufs": -20.0,
      "true_peak_dbtp": -3.2,
      "leading_silence_seconds": 0.0,
      "trailing_silence_seconds": 0.0,
      "sentences": [
        {
          "text": "Then the ground gives way.",
          "start": 0.0,
          "end": 1.625
        },
        {
          "text": "In 1818, Arthur Schopenhauer argued that all wanting comes from lack, and lack is a kind of pain.",
          "start": 2.045,
          "end": 8.391
        },
        {
          "text": "Get what you want, and boredom moves in.",
          "start": 8.941,
          "end": 11.244
        },
        {
          "text": "In his words, life swings like a pendulum backwards and forwards between pain and ennui.",
          "start": 11.574,
          "end": 16.699
        },
        {
          "text": "On this view, lasting happiness was never on offer.",
          "start": 17.319,
          "end": 20.508
        }
      ],
      "warnings": []
    },
    {
      "scene_id": "s06-mill",
      "asset_id": "narr-s06-mill",
      "route": "tts",
      "path": "narration/s06-mill/6c7ed903268406ec.wav",
