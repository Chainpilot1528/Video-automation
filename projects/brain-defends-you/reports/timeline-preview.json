      "cues": [
        {
          "start": 0.25,
          "end": 2.466,
          "text": "For a moment, he feels uncomfortable."
        },
        {
          "start": 2.466,
          "end": 6.059,
          "text": "The failure challenges the person he\nbelieves himself to be."
        },
        {
          "start": 6.059,
          "end": 8.455,
          "text": "Instead of asking, “What did I do wrong,"
        },
        {
          "start": 8.455,
          "end": 13.306,
          "text": "and what can I learn from this?” his mind\nstarts looking for ways to protect him."
        }
      ],
      "fingerprint": "5d109ab2c8360a69eb273485dc6045d4caf42c4d603db612fb92db05ca620e3f"
    },
