      "cues": [
        {
          "start": 0.55,
          "end": 3.603,
          "text": "But one day, Alex fails at something\nimportant."
        },
        {
          "start": 3.603,
          "end": 6.98,
          "text": "Maybe he loses an opportunity, makes a bad\ndecision,"
        },
        {
          "start": 6.98,
          "end": 9.643,
          "text": "or tries something new and gets rejected."
        }
      ],
      "fingerprint": "8134cc180a430f7eb79bd98816d052a73ff32149bbbf64798af254f1059b9fa0"
