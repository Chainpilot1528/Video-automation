      "cues": [
        {
          "start": 0.25,
          "end": 2.781,
          "text": "He tells himself, “The timing wasn't\nright."
        },
        {
          "start": 2.781,
          "end": 5.018,
          "text": "People didn't understand my potential."
        },
        {
          "start": 5.018,
          "end": 9.432,
          "text": "I didn't get a fair chance.” Some of these\nexplanations might even be true."
        },
        {
          "start": 9.432,
          "end": 11.374,
          "text": "But Alex never investigates them."
        },
        {
          "start": 11.374,
          "end": 16.319,
          "text": "He accepts whichever explanation makes him\nfeel better and moves on without learning"
        },
        {
          "start": 16.319,
          "end": 16.966,
          "text": "the lesson."
        }
      ],
      "fingerprint": "2ca65a6f679d9374f590024b4bccc1f66386087d9fb29b900eef588a512d4627"
    },
