      "cues": [
        {
          "start": 0.25,
          "end": 3.25,
          "text": "Whenever Alex succeeds, the story gets\nstronger."
        },
        {
          "start": 3.25,
          "end": 5.313,
          "text": "He thinks, “I knew I was capable."
        },
        {
          "start": 5.313,
          "end": 6.688,
          "text": "I knew I could do it.”"
        }
      ],
      "fingerprint": "cc4a64435322961dedb7df272dde163710c331a3bb6192987791efe02332bcb4"
    },
