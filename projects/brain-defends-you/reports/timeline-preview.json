      "cues": [
        {
          "start": 0.25,
          "end": 2.081,
          "text": "Imagine a person named Alex."
        },
        {
          "start": 2.081,
          "end": 5.677,
          "text": "Alex has always believed that he is smart,\ndisciplined,"
        },
        {
          "start": 5.677,
          "end": 8.161,
          "text": "and capable of achieving great things."
        },
        {
          "start": 8.161,
          "end": 10.907,
          "text": "These beliefs become part of his identity."
        },
        {
          "start": 10.907,
          "end": 14.699,
          "text": "They are not just things he thinks about\nhimself anymore —"
        },
        {
          "start": 14.699,
          "end": 18.295,
          "text": "they become the story he tells himself\nabout who he is."
        }
      ],
      "fingerprint": "dec4566cccebf0e6ac964105ccf566afc1dd24b37ff67c78bb8095c7c2318a3d"
    },
