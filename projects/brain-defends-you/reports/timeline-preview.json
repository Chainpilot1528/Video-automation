      "cues": [
        {
          "start": 0.25,
          "end": 5.019,
          "text": "Over time, he starts confusing individual\nexperiences with his identity."
        },
        {
          "start": 5.019,
          "end": 9.986,
          "text": "One wrong answer becomes “I'm not good at\nthis.” One rejection becomes “I'm"
        },
        {
          "start": 9.986,
          "end": 14.821,
          "text": "unlucky.” One failed attempt becomes\n“Maybe I'm just not meant for this.”"
        }
      ],
      "fingerprint": "d4af0366dd280a93b081c553af602c83fa51f16296fa9d6bd195921cbf507967"
    },
