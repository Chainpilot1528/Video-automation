      "cues": [
        {
          "start": 0.25,
          "end": 0.648,
          "text": "Slowly,"
        },
        {
          "start": 0.648,
          "end": 5.137,
          "text": "Alex learns that he doesn't have to defend\nevery version of himself he has ever"
        },
        {
          "start": 5.137,
          "end": 5.818,
          "text": "believed in."
        },
        {
          "start": 5.818,
          "end": 7.694,
          "text": "He is allowed to change his mind."
        },
        {
          "start": 7.694,
          "end": 9.626,
          "text": "He is allowed to be inexperienced."
        },
        {
          "start": 9.626,
          "end": 13.603,
          "text": "He is allowed to make mistakes without\nturning them into his identity."
        },
        {
          "start": 13.603,
          "end": 14.796,
          "text": "And most importantly,"
        },
        {
          "start": 14.796,
          "end": 18.66,
          "text": "he learns that protecting your ego might\nmake you feel better today,"
        },
        {
          "start": 18.66,
          "end": 22.183,
          "text": "but questioning yourself might make your\nlife better tomorrow."
        }
      ],
      "fingerprint": "0f9a13db59099b74a5124c455453709f7dcab929a94d5477a1b38d9e37db06e3"
