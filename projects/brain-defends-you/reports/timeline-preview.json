      ],
      "cues": [
        {
          "start": 0.25,
          "end": 3.042,
          "text": "And this is where the real problem begins."
        },
        {
          "start": 3.042,
          "end": 8.029,
          "text": "Alex's brain is intelligent enough to\nbuild convincing arguments for almost"
        },
        {
          "start": 8.029,
          "end": 9.957,
          "text": "anything he wants to believe."
        },
        {
          "start": 9.957,
          "end": 11.153,
          "text": "The smarter he is,"
        },
        {
          "start": 11.153,
          "end": 16.738,
          "text": "the better he may become at defending his\nown mistakes rather than recognising them."
        }
      ],
      "fingerprint": "3478f15beff789b843dc5ebbf94e578bfc044d00f559a6c95637de3e6ac9cfb8"
    },
