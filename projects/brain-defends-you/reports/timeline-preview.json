      "cues": [
        {
          "start": 0.25,
          "end": 3.445,
          "text": "For the first time, he starts asking\ndifferent questions."
        },
        {
          "start": 3.445,
          "end": 6.865,
          "text": "Instead of asking, “How can I prove that\nI'm right?” he asks,"
        },
        {
          "start": 6.865,
          "end": 11.237,
          "text": "“What if I'm wrong?” Instead of explaining\naway his failures, he studies them."
        },
        {
          "start": 11.237,
          "end": 13.647,
          "text": "Instead of treating criticism as an\nattack,"
        },
        {
          "start": 13.647,
          "end": 17.235,
          "text": "he considers whether there is something\nuseful hidden inside it."
        }
      ],
      "fingerprint": "f0bda9753714ee7654cd012000086c6a7cc092337a97b58eb8af66662b991e9d"
