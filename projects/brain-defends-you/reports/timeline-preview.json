      "cues": [
        {
          "start": 0.25,
          "end": 5.047,
          "text": "The moment you stop treating your beliefs\nas facts and start examining them as"
        },
        {
          "start": 5.047,
          "end": 5.908,
          "text": "possibilities,"
        },
        {
          "start": 5.908,
          "end": 7.076,
          "text": "real growth begins."
        },
        {
          "start": 7.076,
          "end": 11.689,
          "text": "The biggest obstacle to your improvement\nmay not be a lack of intelligence,"
        },
        {
          "start": 11.689,
          "end": 13.35,
          "text": "discipline, or opportunity."
        },
        {
          "start": 13.35,
          "end": 14.826,
          "text": "It may be your own mind,"
        },
        {
          "start": 14.826,
          "end": 18.823,
          "text": "working tirelessly to convince you that\nyou don't need to change."
        }
