      "cues": [
        {
          "start": 0.25,
          "end": 2.436,
          "text": "Then, one day, something changes."
        },
        {
          "start": 2.436,
          "end": 6.941,
          "text": "Alex begins to notice that whenever\nevidence challenges his beliefs,"
        },
        {
          "start": 6.941,
          "end": 10.12,
          "text": "he immediately looks for a reason to\ndismiss it."
        },
        {
          "start": 10.12,
          "end": 15.354,
          "text": "He realises that he has been protecting\nhis self-image instead of improving his"
        },
        {
          "start": 15.354,
          "end": 15.685,
          "text": "life."
        }
      ],
