      "cues": [
        {
          "start": 0.551,
          "end": 5.383,
          "text": "What should have been a single event\nbecomes a verdict on his entire life."
        },
        {
          "start": 5.383,
          "end": 7.865,
          "text": "The truth is, being wrong is an event."
        },
        {
          "start": 7.865,
          "end": 11.456,
          "text": "Being a failure is an identity we attach\nto that event."
        }
      ],
      "fingerprint": "9136928d083b2190cc9e5aba08b65c196710a0fcb028c132294c7b9e8f11532e"
