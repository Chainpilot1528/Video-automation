      "cues": [
        {
          "start": 0.569,
          "end": 3.164,
          "text": "Because eventually, everyone faces a\nchoice."
        },
        {
          "start": 3.164,
          "end": 6.231,
          "text": "Do you want to protect the person you\nthink you are,"
        },
        {
          "start": 6.231,
          "end": 10.065,
          "text": "or do you want to become the person you\nhave the potential to be?"
        }
      ],
      "fingerprint": "b06a998332a00f26de35dca7791cccb8c4e179c7f712fcf1eeeae03bf83c1f4c"
