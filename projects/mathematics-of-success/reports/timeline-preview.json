      ],
      "cues": [
        {
          "start": 0.25,
          "end": 2.578,
          "text": "Third: rewards aren't shared out evenly."
        },
        {
          "start": 2.578,
          "end": 7.233,
          "text": "Economist Sherwin Rosen showed how, when\none performer can reach a whole market,"
        },
        {
          "start": 7.233,
          "end": 10.433,
          "text": "a small edge in talent can mean a huge gap\nin earnings."
        },
        {
          "start": 10.433,
          "end": 14.623,
          "text": "And a study of more than six hundred\nthousand researchers, entertainers,"
        },
        {
          "start": 14.623,
          "end": 18.522,
          "text": "politicians and athletes found that\nperformance itself is lopsided:"
        },
        {
          "start": 18.522,
          "end": 21.548,
          "text": "a small group at the top far outpaces\neveryone else."
        }
      ],
      "fingerprint": "121c219d23f25e864b7e7212bd898b0ea2030ce021b1f45d052aa5a06235af09"
    },
