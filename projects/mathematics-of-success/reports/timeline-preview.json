      "cues": [
        {
          "start": 0.25,
          "end": 4.979,
          "text": "Two people start on the same day, with the\nsame skills, and work just as hard."
        },
        {
          "start": 4.979,
          "end": 6.858,
          "text": "A year later, one is far ahead."
        },
        {
          "start": 6.858,
          "end": 8.737,
          "text": "Is that unfair, or is it maths?"
        },
        {
          "start": 8.737,
          "end": 11.647,
          "text": "Researchers have found patterns in who\nmakes it."
        },
        {
          "start": 11.647,
          "end": 12.496,
          "text": "Here are five."
        }
      ],
      "fingerprint": "b061c75e87bbcc6f3a45e42c6047dcb87a02bd9112244b4b3c2ee88d03972692"
    },
