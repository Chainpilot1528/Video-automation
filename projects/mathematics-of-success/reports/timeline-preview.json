      "cues": [
        {
          "start": 0.25,
          "end": 1.667,
          "text": "Fifth: aim your effort."
        },
        {
          "start": 1.667,
          "end": 2.591,
          "text": "Taken together,"
        },
        {
          "start": 2.591,
          "end": 7.826,
          "text": "this research suggests hard work pays most\nwhen it goes into skills and markets where"
        },
        {
          "start": 7.826,
          "end": 9.428,
          "text": "gains build on themselves."
        },
        {
          "start": 9.428,
          "end": 14.54,
          "text": "Choosing the field, the skill and the\nthing you build matters as much as the\nhours."
        }
      ],
      "fingerprint": "39cc32a2739d9e4c1c997aa37c7f4f7d4b22fdfe7368f5ff7d53abb9b948ba91"
    },
