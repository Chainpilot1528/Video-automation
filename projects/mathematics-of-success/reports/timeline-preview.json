      "cues": [
        {
          "start": 0.25,
          "end": 3.538,
          "text": "So effort matters, but it isn't the whole\nequation."
        },
        {
          "start": 3.538,
          "end": 7.083,
          "text": "Compounding, unequal rewards and luck\nshape the result."
        },
        {
          "start": 7.083,
          "end": 10.435,
          "text": "The part you control is where you point\nyour effort."
        }
      ],
      "fingerprint": "5626862d0a83556b5b0469abee4c3879e82e46da9869bdc5fc00ea2b98a91460"
