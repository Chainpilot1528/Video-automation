      "cues": [
        {
          "start": 0.25,
          "end": 1.983,
          "text": "Fourth: luck compounds too."
        },
        {
          "start": 1.983,
          "end": 6.989,
          "text": "One computer model of forty-year careers\nfound the most successful people were"
        },
        {
          "start": 6.989,
          "end": 8.593,
          "text": "rarely the most talented,"
        },
        {
          "start": 8.593,
          "end": 10.903,
          "text": "but moderately talented and luckier."
        },
        {
          "start": 10.903,
          "end": 13.085,
          "text": "It's a simulation, not real lives."
        },
        {
          "start": 13.085,
          "end": 17.642,
          "text": "One possible lesson: be prepared, so a\nlucky break has somewhere to go."
        }
      ],
      "fingerprint": "1c719e67072935e7762a2b756d19992b3b8b313a3e8450ad16cbdc5e550e3dcf"
    },
