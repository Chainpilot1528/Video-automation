        }
      ],
      "cues": [
        {
          "start": 0.25,
          "end": 2.248,
          "text": "Second: small advantages compound."
        },
        {
          "start": 2.248,
          "end": 4.775,
          "text": "Improve by one percent a day and, on\npaper,"
        },
        {
          "start": 4.775,
          "end": 8.242,
          "text": "a year multiplies where you started by\nalmost thirty-eight."
        },
        {
          "start": 8.242,
          "end": 11.767,
          "text": "Slip one percent a day and you keep less\nthan three percent."
        },
        {
          "start": 11.767,
          "end": 14.353,
          "text": "Real life is messier, but the shape is\nreal."
        },
        {
          "start": 14.353,
          "end": 17.585,
          "text": "Sociologist Robert Merton called it the\nMatthew effect:"
        },
        {
          "start": 17.585,
          "end": 22.227,
          "text": "scientists who are already recognised tend\nto get more credit for similar work."
        }
      ],
      "fingerprint": "5bf39838d6a15b1872daa047b49e1bc630dd25c59a41a20c772d3462fd913f99"
    },
    {
