      "cues": [
        {
          "start": 0.25,
          "end": 3.776,
          "text": "First: the same start doesn't mean the\nsame outcome."
        },
        {
          "start": 3.776,
          "end": 8.657,
          "text": "In one online experiment, 14,341 people\ncould download unfamiliar songs."
        },
        {
          "start": 8.657,
          "end": 11.301,
          "text": "When they could see what others picked,"
        },
        {
          "start": 11.301,
          "end": 16.793,
          "text": "the same songs ended up with very\ndifferent levels of success in separate\ngroups."
        },
        {
          "start": 16.793,
          "end": 20.59,
          "text": "Quality still mattered: the best songs\nrarely did badly."
        }
      ],
      "fingerprint": "3ec800309ae04835a93efdf734f323d7743f827be7031fe10e64ef2620943550"
    },
