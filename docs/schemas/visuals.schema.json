{
  "$defs": {
    "BeatReview": {
      "enum": [
        "pending",
        "approved",
        "changes_requested"
      ],
      "title": "BeatReview",
      "type": "string"
    },
    "ChapterMapView": {
      "additionalProperties": false,
      "description": "Show the chapter map: rest on ``from_level``, ease down to ``level``, and place the medallions.\n\nGoing down, the new level's medallions fade in once the camera arrives; the others (and all of\nthem when the camera climbs back up, as a recap) are there from the start.",
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "from_level": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Level"
        },
        "level": {
          "maximum": 8,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/MapMarker"
          },
          "title": "Markers",
          "type": "array"
        },
        "pan_seconds": {
          "default": 3.5,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Pan Seconds",
          "type": "number"
        },
        "pan_start": {
          "default": 0.8,
          "minimum": 0,
          "title": "Pan Start",
          "type": "number"
        }
      },
      "required": [
        "asset_id",
        "level"
      ],
      "title": "ChapterMapView",
      "type": "object"
    },
    "GenerationRequest": {
      "additionalProperties": false,
      "description": "A request for a generated visual, linked to its beat and scene.",
      "properties": {
        "negative_prompt": {
          "default": "",
          "title": "Negative Prompt",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "status": {
          "default": "requested",
          "enum": [
            "requested",
            "generated",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "GenerationRequest",
      "type": "object"
    },
    "GraphicKind": {
      "enum": [
        "title",
        "diagram",
        "chart",
        "timeline",
        "map",
        "screen",
        "chapter_map"
      ],
      "title": "GraphicKind",
      "type": "string"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One element of a composition: an image, a block of text or a simple shape on a dark canvas.\n\nPositions and sizes are fractions of the frame, so a layout works at any resolution.\nTimes are seconds from the start of the beat. Motion is a drift and zoom over the layer's\nown lifetime, or over ``motion_start``-``motion_end`` (eased if ``motion_ease``) to make\nan element slide into place at a given moment.",
      "properties": {
        "align": {
          "default": "center",
          "enum": [
            "center",
            "left"
          ],
          "title": "Align",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "claim_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "color": {
          "default": "ink",
          "enum": [
            "ink",
            "dim",
            "accent",
            "stone"
          ],
          "title": "Color",
          "type": "string"
        },
        "crop": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop"
        },
        "drift_x": {
          "default": 0.0,
          "maximum": 2,
          "minimum": -2,
          "title": "Drift X",
          "type": "number"
        },
        "drift_y": {
          "default": 0.0,
          "maximum": 2,
          "minimum": -2,
          "title": "Drift Y",
          "type": "number"
        },
        "edge": {
          "default": "none",
          "enum": [
            "none",
            "feather",
            "oval",
            "circle"
          ],
          "title": "Edge",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "enter": {
          "default": "auto",
          "enum": [
            "auto",
            "none",
            "rise",
            "settle",
            "slide_left",
            "slide_right"
          ],
          "title": "Enter",
          "type": "string"
        },
        "fade_in": {
          "default": 1.2,
          "maximum": 10,
          "minimum": 0,
          "title": "Fade In",
          "type": "number"
        },
        "fade_out": {
          "default": 1.2,
          "maximum": 10,
          "minimum": 0,
          "title": "Fade Out",
          "type": "number"
        },
        "feather": {
          "default": 0.09,
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Feather",
          "type": "number"
        },
        "flip": {
          "default": false,
          "title": "Flip",
          "type": "boolean"
        },
        "highlight": {
          "default": "",
          "title": "Highlight",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "text",
            "shape"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_height": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 1.5,
          "title": "Max Height",
          "type": "number"
        },
        "motion_ease": {
          "default": false,
          "title": "Motion Ease",
          "type": "boolean"
        },
        "motion_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motion End"
        },
        "motion_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motion Start"
        },
        "pulse": {
          "default": 0.0,
          "maximum": 20,
          "minimum": 0,
          "title": "Pulse",
          "type": "number"
        },
        "reveal": {
          "default": "fade",
          "enum": [
            "fade",
            "words",
            "draw"
          ],
          "title": "Reveal",
          "type": "string"
        },
        "ring": {
          "default": false,
          "title": "Ring",
          "type": "boolean"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "shape": {
          "anyOf": [
            {
              "enum": [
                "circle",
                "ring",
                "line",
                "arrow",
                "person",
                "glow",
                "stars",
                "shade"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        },
        "start": {
          "default": 0.0,
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "text_style": {
          "default": "label",
          "enum": [
            "quote",
            "label",
            "caption",
            "heading",
            "statement",
            "title",
            "chapter"
          ],
          "title": "Text Style",
          "type": "string"
        },
        "width": {
          "default": 0.4,
          "exclusiveMinimum": 0,
          "maximum": 1.5,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "default": 0.5,
          "maximum": 3,
          "minimum": -2,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.5,
          "maximum": 3,
          "minimum": -2,
          "title": "Y",
          "type": "number"
        },
        "zoom_from": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "title": "Zoom From",
          "type": "number"
        },
        "zoom_to": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "title": "Zoom To",
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Layer",
      "type": "object"
    },
    "MapMarker": {
      "additionalProperties": false,
      "description": "A portrait medallion placed on a level of the chapter map.",
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "crop": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop"
        },
        "level": {
          "maximum": 8,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "slot": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot"
        }
      },
      "required": [
        "level",
        "asset_id"
      ],
      "title": "MapMarker",
      "type": "object"
    },
    "Motion": {
      "enum": [
        "none",
        "slow_push",
        "pan",
        "reveal",
        "highlight",
        "build"
      ],
      "title": "Motion",
      "type": "string"
    },
    "VisualBeat": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "beat_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Beat Id",
          "type": "string"
        },
        "chapter_map": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChapterMapView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claim_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "graphic_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphicKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_reconstruction": {
          "default": false,
          "title": "Is Reconstruction",
          "type": "boolean"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "title": "Layers",
          "type": "array"
        },
        "motion": {
          "$ref": "#/$defs/Motion",
          "default": "none"
        },
        "motion_purpose": {
          "default": "",
          "title": "Motion Purpose",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "offset_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Seconds"
        },
        "on_screen_text": {
          "items": {
            "type": "string"
          },
          "title": "On Screen Text",
          "type": "array"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "requirements": {
          "default": "",
          "title": "Requirements",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/BeatReview",
          "default": "pending"
        },
        "scene_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Scene Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "takeaway": {
          "minLength": 1,
          "title": "Takeaway",
          "type": "string"
        },
        "visual_question": {
          "default": "",
          "title": "Visual Question",
          "type": "string"
        },
        "visual_type": {
          "$ref": "#/$defs/VisualType"
        }
      },
      "required": [
        "beat_id",
        "scene_id",
        "order",
        "takeaway",
        "visual_type"
      ],
      "title": "VisualBeat",
      "type": "object"
    },
    "VisualType": {
      "enum": [
        "primary_evidence",
        "original_graphic",
        "licensed_stock",
        "generated",
        "typography"
      ],
      "title": "VisualType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "beats": {
      "items": {
        "$ref": "#/$defs/VisualBeat"
      },
      "title": "Beats",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "VisualPlan",
  "type": "object"
}
