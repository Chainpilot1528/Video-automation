{
  "$defs": {
    "BarDatum": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "BarDatum",
      "type": "object"
    },
    "MapLevel": {
      "additionalProperties": false,
      "properties": {
        "subtitle": {
          "default": "",
          "title": "Subtitle",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "MapLevel",
      "type": "object"
    },
    "TimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "when": {
          "minLength": 1,
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "when",
        "text"
      ],
      "title": "TimelineEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Input for ``pipeline graphics render``. Data must cite ledger sources.",
  "properties": {
    "asset_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Asset Id",
      "type": "string"
    },
    "bars": {
      "items": {
        "$ref": "#/$defs/BarDatum"
      },
      "title": "Bars",
      "type": "array"
    },
    "data_locator": {
      "default": "",
      "title": "Data Locator",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "intended_scene_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Intended Scene Ids",
      "type": "array"
    },
    "kind": {
      "enum": [
        "title",
        "bar_chart",
        "timeline",
        "chapter_map"
      ],
      "title": "Kind",
      "type": "string"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/MapLevel"
      },
      "title": "Levels",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "style": {
      "default": "steps",
      "enum": [
        "steps",
        "core"
      ],
      "title": "Style",
      "type": "string"
    },
    "subtitle": {
      "default": "",
      "title": "Subtitle",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "units": {
      "default": "",
      "title": "Units",
      "type": "string"
    },
    "variant": {
      "default": "map",
      "enum": [
        "map",
        "overview"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "kind",
    "title"
  ],
  "title": "GraphicSpec",
  "type": "object"
}
