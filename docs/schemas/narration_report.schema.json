{
  "$defs": {
    "ChunkReport": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "cached": {
          "title": "Cached",
          "type": "boolean"
        },
        "channels": {
          "title": "Channels",
          "type": "integer"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "integrated_lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrated Lufs"
        },
        "leading_silence_seconds": {
          "default": 0.0,
          "title": "Leading Silence Seconds",
          "type": "number"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "route": {
          "enum": [
            "imported",
            "tts"
          ],
          "title": "Route",
          "type": "string"
        },
        "sample_rate": {
          "title": "Sample Rate",
          "type": "integer"
        },
        "scene_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Scene Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "trailing_silence_seconds": {
          "default": 0.0,
          "title": "Trailing Silence Seconds",
          "type": "number"
        },
        "true_peak_dbtp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "True Peak Dbtp"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "asset_id",
        "route",
        "path",
        "sha256",
        "fingerprint",
        "cached",
        "duration_seconds",
        "sample_rate",
        "channels"
      ],
      "title": "ChunkReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``reports/narration.json``, rewritten on each build.",
  "properties": {
    "built_at": {
      "format": "date-time",
      "title": "Built At",
      "type": "string"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/ChunkReport"
      },
      "title": "Chunks",
      "type": "array"
    },
    "missing": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "voice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "built_at"
  ],
  "title": "NarrationReport",
  "type": "object"
}
