# Copy to .env and edit locally. Placeholders only — never commit real secrets.
# The pipeline reads these from the environment; export them or use direnv.

# Where projects live (relative to the repo root or absolute).
PIPELINE_PROJECTS_ROOT=projects

# Optional external folder for large source media and renders. Empty = inside each project.
PIPELINE_MEDIA_ROOT=

# Local model weights (e.g. u2net/u2net.onnx for background removal). Git-ignored.
PIPELINE_MODELS_DIR=models

# DEBUG | INFO | WARNING | ERROR
PIPELINE_LOG_LEVEL=INFO
# text | json
PIPELINE_LOG_FORMAT=text

# Override if FFmpeg is not on PATH.
PIPELINE_FFMPEG_PATH=ffmpeg
PIPELINE_FFPROBE_PATH=ffprobe

# Disk thresholds in GiB used by `pipeline doctor`.
PIPELINE_MIN_FREE_DISK_GB=10
PIPELINE_WARN_FREE_DISK_GB=25

# Safety switches. Keep false unless explicitly approved.
PIPELINE_ALLOW_NETWORK=false
PIPELINE_ALLOW_PAID_PROVIDERS=false

# Comma-separated names allowed to approve scripts and record claim reviews/exceptions.
# Empty = any named person may (the name is always recorded).
PIPELINE_AUTHORIZED_REVIEWERS=

# Voicebox (local TTS app). Must stay on this machine unless PIPELINE_ALLOW_NETWORK is approved.
PIPELINE_VOICEBOX_URL=http://127.0.0.1:17493
PIPELINE_VOICEBOX_ENGINE=kokoro

# Pexels stock API key (free at https://www.pexels.com/api/). Put the real key in your shell profile
# (e.g. ~/.zprofile), never in this file or the repo.
PIPELINE_PEXELS_API_KEY=

# Local AI drafting: "voicebox" uses the Qwen3 model inside the Voicebox app (nothing leaves this Mac).
PIPELINE_LLM_PROVIDER=none
PIPELINE_LLM_MODEL_SIZE=1.7B

# Ollama (local, quantized models; recommended for drafting on 8 GB Macs).
PIPELINE_OLLAMA_URL=http://127.0.0.1:11434
PIPELINE_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
